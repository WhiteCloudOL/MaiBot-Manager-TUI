# Copy to .env.deploy on this machine. Real values must never be committed.
# Values are literal; shell commands, escapes and ${VARIABLE} expansion are not evaluated.
MMTUI_SSH_TARGET=your-ssh-alias
MMTUI_REMOTE_DIR=/srv/downloads/your-project
MMTUI_CACHE_URL=https://downloads.example.com/your-project/
EDGEONE_ZONE_ID=zone-replacewithyourid

# Prefer an existing local Tencent Cloud SecretId/SecretKey CSV, outside this repository.
# On Windows, use forward slashes or single quotes for paths.
EDGEONE_CREDENTIALS_CSV='C:/private/tencentcloud-credentials.csv'

# Or use both environment variables below; environment credentials take precedence.
# TENCENTCLOUD_SECRET_ID=
# TENCENTCLOUD_SECRET_KEY=
# TENCENTCLOUD_TOKEN=

# Optional settings. Without an override, OpenSSH uses ~/.ssh/config.
# MMTUI_SSH_CONFIG_FILE='C:/Users/your-user/.ssh/config'
# MMTUI_HTTP_PROXY=http://127.0.0.1:8080
# GITHUB_TOKEN=
MMTUI_RELEASE_REPO=WhiteCloudOL/MaiBot-Manager-TUI
MMTUI_COMMAND_TIMEOUT=300
MMTUI_PURGE_WAIT=180
